# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Environment ------------------------------------------------------------
# development | test | production. Production refuses weak secrets, insecure
# cookies and demo funding at startup.
APP_ENV=development
# Keeps all money simulated and refuses live-mode Stripe keys/events
SANDBOX_MODE=true
FRONTEND_URL=http://localhost:5173
# Must include the exact origin the app is served from
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ------------------------------------------------------------------
# Restricted LOGIN used by FastAPI, background workers, and maintenance tasks.
DATABASE_URL=postgresql://velqorin_app:your_runtime_password@localhost:5432/digital_banking_db
# Separate non-superuser schema owner used only by Alembic.
MIGRATION_DATABASE_URL=postgresql://velqorin_migrator:your_migration_password@localhost:5432/digital_banking_db

# --- Sessions & secrets ----------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_SESSION_EXPIRE_MINUTES=30
# true in production (HTTPS). false only for local http development.
COOKIE_SECURE=false
# Encrypts admin MFA secrets at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=your_fernet_key_here
# Authenticator-app step for admins. false = password-only (development only; refused in production)
ADMIN_MFA_REQUIRED=true

# --- One-time email codes ------------------------------------------------------------
EMAIL_CODE_EXPIRE_MINUTES=10
PASSWORD_RESET_CODE_EXPIRE_MINUTES=15
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60

# --- Email (transactional provider over SMTP) ----------------------------------------
# Gmail: smtp.gmail.com, 587, starttls, and a 16-character App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=VELQORIN
# background (worker thread with retries) | sync
EMAIL_DELIVERY_MODE=background

# --- AI ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# --- Stripe (TEST MODE keys only: sk_test_ / pk_test_) ----------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From `stripe listen --forward-to localhost:8000/payments/stripe/webhook`
# or the Dashboard webhook endpoint (Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=inr
PAYMENT_MIN_AMOUNT_MINOR=5000
PAYMENT_MAX_AMOUNT_MINOR=10000000

# --- Development only ------------------------------------------------------------------
# Simulated funding without a payment (POST /transactions/deposit). Always
# refused when APP_ENV=production. Every use is audited.
DEMO_FUNDING_ENABLED=false

# --- Admin provisioning (only when running scripts/create_admin.py) ----------------------
# Prefer the interactive prompt; if you use these, set them in your shell, not here.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
